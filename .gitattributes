# Auto detect text files and perform LF normalization
* text=auto

# data-raw/ is immutable input, reproduced byte for byte, and PROVENANCE.md
# records the sha256 of those exact bytes. EPA publishes this CSV as
# windows-1252 with CRLF endings, which `* text=auto` above would normalize to
# LF on commit, so the committed blob would no longer hash to the value
# PROVENANCE.md claims and the vendored copy would stop being the citable
# artifact it is meant to be. Turning off text handling keeps the bytes.
data-raw/** -text

# images/ holds EPA's published figure image, vendored byte for byte and hashed
# in data-raw/PROVENANCE.md for the same reason data-raw/ is. `* text=auto`
# above would normally detect a PNG as binary on its own; this says so outright
# rather than leaving the checksum to depend on that detection.
images/** -text

# data/ is generated by R/build_data.R, which writes LF only, and
# tests/test-data.R asserts exactly that via assert_clean_output()
# (R/utils/write_stable.R). On Windows core.autocrlf=true rewrites checked-out
# text files to CRLF, so without this pin a fresh clone, or any checkout that
# touches these files such as switching branches, fails the repo's own hygiene
# tests until the data happens to be rebuilt.
data/** text eol=lf
